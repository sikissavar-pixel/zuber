# Frontend environment variables
# Set your Google Play Billing product ID here so the mobile purchase button knows what to buy.
# This must match the productId you configured in Google Play Console under In-app products.

NEXT_PUBLIC_GOOGLE_PRODUCT_ID=vip_ride_001
# API endpoint for REST requests (local default shown)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Dedicated Socket.IO endpoint (falls back to API URL in dev)
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000